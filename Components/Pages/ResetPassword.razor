@page "/reset-password/{Token}"
@layout Layout.LoginLayout

@inject NavigationManager NavigationManager
@using BlazorSuperApp.Models;
@using System.ComponentModel.DataAnnotations;
@inject BlazorSuperApp.Services.AuthService AuthService
@rendermode InteractiveServer

<EditForm Model="resetModel" OnValidSubmit="HandleValidSubmit" FormName="resetForm">
    <DataAnnotationsValidator />
    <h2 class="text-center mb-3">Mot de passe oublié?</h2>
    <p class="text-center">Nous vous enverrons un lien par email pour vous permettre de modifier votre mot de passe.</p>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="mb-3">
        <label for="password">Password</label>
        <InputText type="password" id="password" class="form-control" @bind-Value="resetModel.Password"
            placeholder="*******" />
        <ValidationMessage For="@(() => resetModel.Password)" />
    </div>

    <div class="mb-3">
        <label for="confirmPassword">Confirmer le mot de passe</label>
        <InputText type="password" id="confirmPassword" class="form-control" @bind-Value="resetModel.ConfirmPassword"
            placeholder="*******" />
        <ValidationMessage For="@(() => resetModel.ConfirmPassword)" />
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Valider</button>
    </div>


</EditForm>

@code {
    [Parameter]
    public string Token { get; set; }

    private ResetPasswordModel resetModel = new();

    private String? errorMessage;

    private async Task HandleValidSubmit()
    {
        resetModel.Token = Token;


        errorMessage = await AuthService.ResetPassword(resetModel);

        if (errorMessage is null)
        {
            NavigationManager.NavigateTo("/");
        }
    }
}