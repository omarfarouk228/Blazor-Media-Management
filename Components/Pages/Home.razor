@page "/home"

@* @using Microsoft.AspNetCore.Authorization
@attribute [Authorize] *@
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<button class="btn btn-success" @onclick="ShowModal">Créer un utilisateur</button>

<UserFormModal @ref="formModal" />

@code {
    private UserFormModal? formModal;

    private async Task ShowModal()
    {
        await JS.InvokeVoidAsync("showBootstrapModal", "userModal");
    }
}