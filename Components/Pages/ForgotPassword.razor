@page "/forgot-password"
@layout Layout.LoginLayout

@inject NavigationManager NavigationManager
@using BlazorSuperApp.Models;
@using System.ComponentModel.DataAnnotations;
@inject BlazorSuperApp.Services.AuthService AuthService
@rendermode InteractiveServer

<EditForm Model="forgotModel" OnValidSubmit="HandleValidSubmit" FormName="loginForm">
    <DataAnnotationsValidator />
    <h2 class="text-center mb-3">Mot de passe oublié?</h2>
    <p class="text-center">Nous vous enverrons un lien par email pour vous permettre de modifier votre mot de passe.</p>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (isSent)
    {
        <div class="alert alert-success">Un lien de réinitialisation de mot de passe vous a été envoyé par email</div>
    }


    <div class="mb-3">
        <label for="email">Email</label>
        <InputText id="email" type="email" class="form-control" @bind-Value="forgotModel.Email"
            placeholder="john@gmail.com" />
        <ValidationMessage For="@(() => forgotModel.Email)" />
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Valider</button>
    </div>


</EditForm>

@code {
    private ForgotPasswordModel forgotModel = new();

    private String? errorMessage;

    private bool isSent = false;

    private async Task HandleValidSubmit()
    {
        errorMessage = await AuthService.ForgotPassword(forgotModel);

        if (errorMessage is null)
        {
            isSent = true;
        }

    }
}