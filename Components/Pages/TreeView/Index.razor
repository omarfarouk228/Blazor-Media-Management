@page "/treeview"
@using BlazorSuperApp.Dtos
@inject BlazorSuperApp.Services.FolderService FolderService
<PageTitle>TreeView</PageTitle>
@rendermode InteractiveServer

<h1>TreeView</h1>

@if (isLoading)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (treeData.Count > 0)
{
    <ul style="padding-left: 0;">
        @foreach (var node in treeData)
        {
            <TreeNodeDisplay TreeNode="node" Level="0" />
        }
    </ul>
}
else
{
    <p><em>Aucune donnée à afficher dans l'arbre.</em></p>
}

@code {
    private List<FolderDto> treeData = new();
    private bool isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            treeData = await FolderService.GetAll();
            isLoading = false;
            StateHasChanged();
        }
    }
}