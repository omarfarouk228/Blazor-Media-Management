@using BlazorSuperApp.Models
@using BlazorSuperApp.Dtos;
@inject BlazorSuperApp.Services.FolderService FolderService
@inject BlazorSuperApp.Services.FileService FileService

<ConfirmDialog @ref="dialog" />
<Modal @ref="modal" />

<li style="list-style-type: none;">
    <div @onclick="ToggleExpand" style="padding-left: @(Level * 20)px;">
        @if (TreeNode.HasFiles || TreeNode.HasChildrens)
        {
            <span class="fa @(TreeNode.IsExpanded ? "fa-caret-down" : "fa-caret-right")" style="width: 20px;"></span>
        }
        else
        {
            <span style="width: 20px;"></span>
        }

        <span class="fa fa-folder mr-2"></span>
        @TreeNode.Name

        <Button Color="ButtonColor.Success" @onclick="ShowEditModalAsync" Size="ButtonSize.Small" Class="p-0 px-1">
            <Icon Name="IconName.Pencil" />
        </Button>

        <Button Color="ButtonColor.Danger" @onclick="ShowConfirmationAsync" Size="ButtonSize.Small" Class="p-0 px-1">
            <Icon Name="IconName.Trash" />
        </Button>

    </div>

    @if (TreeNode.IsExpanded)
    {
        @if (TreeNode.HasChildrens)
        {
            <ul style="padding-left: 0;">
                @foreach (var child in TreeNode.SubFolders)
                {
                    <TreeNodeDisplay TreeNode="child" Level="Level + 1" OnDeleted="HandleSubFolderDeleted" />
                }
            </ul>
        }

        @if (TreeNode.Files.Any())
        {
            <ul style="padding-left: @((Level + 1) * 20)px;">
                @foreach (var file in TreeNode.Files)
                {
                    <li style="list-style-type: none;">
                        <span class="fa fa-file mr-2"></span>
                        @file.Name
                    </li>
                }
            </ul>
        }


    }

</li>

@code {
    [Parameter]
    public FolderDto TreeNode { get; set; }

    [Parameter]
    public int Level { get; set; } = 0;

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private bool isLoading = false;

    private ConfirmDialog dialog;

    private Modal modal = default!;

    protected override async Task OnInitializedAsync()
    {
        TreeNode.HasFiles = await FolderService.HasFiles(TreeNode.Id);
        TreeNode.HasChildrens = await FolderService.HasChildrens(TreeNode.Id);
    }

    private async void ToggleExpand()
    {
        if (!TreeNode.IsExpanded)
        {
            isLoading = true;

            // Charger les sous-dossiers
            if (TreeNode.SubFolders.Any() == false)
            {
                TreeNode.SubFolders = await FolderService.GetChildrens(TreeNode.Id);
            }

            // Charges les fichiers
            if (TreeNode.HasFiles && TreeNode.Files.Any() == false)
            {
                TreeNode.Files = await FileService.GetByFolder(TreeNode.Id);
            }

            isLoading = false;
        }
        TreeNode.IsExpanded = !TreeNode.IsExpanded;

        StateHasChanged();
    }

    private async Task ShowConfirmationAsync()
    {
        var confirmation = await dialog.ShowAsync(
        title: "Suppression de dossier?",
        message1: "Êtes-vous sûr de supprimer ce dossier et tout son contenu?");

        if (confirmation)
        {
            await FolderService.Delete(TreeNode.Id);
            await OnDeleted.InvokeAsync();
        }
        else
        {

        }

    }
    private async Task HandleSubFolderDeleted()
    {
        TreeNode.HasChildrens = await FolderService.HasChildrens(TreeNode.Id);
        TreeNode.SubFolders = await FolderService.GetChildrens(TreeNode.Id);
        StateHasChanged();
    }

    private async Task ShowEditModalAsync()
    {
        var parameters = new Dictionary<string, object>();
        parameters.Add("folderDto", TreeNode);
        parameters.Add("onUpdated", EventCallback.Factory.Create<MouseEventArgs>(this, HandleUpdate));
        await modal.ShowAsync<EditFolder>(title: "Editer un dossier", parameters: parameters);
    }

    private async Task HandleUpdate(MouseEventArgs args)
    {
        await modal.HideAsync();
    }

}
