@page "/groups/edit/{Id:int}"
@using BlazorSuperApp.Models
@using BlazorSuperApp.Dtos;
@inject BlazorSuperApp.Services.GroupService GroupService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Modifier un groupe</PageTitle>

<h1>Modifier un groupe</h1>

<EditForm Model="group" OnValidSubmit="UpdateValidSubmit" FormName="editGroupForm">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="name">Nom</label>
        <InputText id="name" class="form-control" @bind-Value="group.Name" placeholder="Groupe 3" />
        <ValidationMessage For="@(() => group.Name)" />
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Modifier</button>
    </div>
</EditForm>

@code {
    [Parameter] public int Id { get; set; }
    private GroupEditModel group = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            GroupDto? groupDto = await GroupService.GetById(Id);
            if (groupDto != null)
            {
                group.Name = groupDto.Name;
                group.Id = groupDto.ID;
            }
            StateHasChanged();
        }
    }

    private async Task UpdateValidSubmit()
    {
        await GroupService.Update(Id, group);
        NavigationManager.NavigateTo("/groups");
    }
}
