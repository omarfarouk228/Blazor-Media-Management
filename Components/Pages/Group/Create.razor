@page "/groups/create"
@using BlazorSuperApp.Models
@inject BlazorSuperApp.Services.GroupService GroupService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Ajouter un groupe</PageTitle>

<h1>Ajouter un groupe</h1>

<EditForm Model="group" OnValidSubmit="AddValidSubmit" FormName="addGroupForm">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="name">Nom</label>
        <InputText id="name" class="form-control" @bind-Value="group.Name" placeholder="Groupe 3" />
        <ValidationMessage For="@(() => group.Name)" />
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Créer</button>
    </div>
</EditForm>

@code {
    private GroupFormModel group = new();

    private async Task AddValidSubmit()
    {
        await GroupService.Create(group);
        NavigationManager.NavigateTo("/groups");
    }
}
